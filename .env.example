# ============================================================
#  quantbot configuration  (copy to .env — .env is gitignored)
# ============================================================

# ---- Trading mode --------------------------------------------------
# PAPER = IBKR paper account (default, safe). LIVE = real money (needs a live port + intent).
QUANTBOT_MODE=PAPER

# ---- Execution -----------------------------------------------------
# execute=false => DRY-RUN: compute + log orders, place NOTHING. Safe default.
# Set true only once IB Gateway is up and you want (paper) orders actually placed.
QUANTBOT_EXECUTE=false
EXEC_MIN_TRADE_USD=50          # skip rebalances smaller than this (cuts turnover/costs)
EXEC_ORDER_TYPE=MKT           # MKT | LMT
EXEC_ALLOW_FRACTIONAL=false   # IBKR supports fractional shares for many US names

# ---- IBKR connection (IB Gateway / TWS) ----------------------------
# Ports: 4002 paper-Gateway (default), 7497 paper-TWS, 4001 live-Gateway, 7496 live-TWS
IBKR_HOST=127.0.0.1
IBKR_PORT=4002
IBKR_CLIENT_ID=1
IBKR_ACCOUNT=                 # e.g. DU1234567 (paper); optional if the login has one account
IBKR_READONLY=false

# ---- Capital (fallback notional if the broker doesn't report equity) --
STARTING_EQUITY_USD=100000

# ---- Data (backtest/research source — NOT IBKR) --------------------
DATA_PROVIDER=yfinance        # yfinance | stooq
DATA_START=2010-01-01

# ---- Risk limits (HARD caps — nothing may exceed these at runtime) --
RISK_MAX_SINGLE_POSITION_PCT=0.20
RISK_MAX_SLEEVE_PCT=0.60
RISK_MAX_GROSS_EXPOSURE_PCT=1.00
RISK_MAX_DAILY_LOSS_PCT=0.03
RISK_MAX_DRAWDOWN_PCT=0.20

# ---- Backtest assumptions ------------------------------------------
BT_COST_BPS=5                 # round-turn slippage+commission
BT_CASH_RATE=0.04             # interest on idle cash / T-bills
