# ============================================================
#  quantbot configuration  (copy to .env — .env is gitignored)
# ============================================================

# ---- Trading mode --------------------------------------------------
# PAPER = simulate fills locally, no real orders (DEFAULT, safe)
# LIVE  = place real orders on Gemini  (requires keys below + explicit opt-in)
QUANTBOT_MODE=PAPER

# ---- Gemini API ----------------------------------------------------
# Public market data needs NO keys. Keys are only required for LIVE
# trading and private account/balance calls.
# Create keys at: https://exchange.gemini.com/settings/api
GEMINI_API_KEY=
GEMINI_API_SECRET=
# Use Gemini's sandbox exchange (api.sandbox.gemini.com) for safe testing.
# true = sandbox, false = production. Recommended: true until fully validated.
GEMINI_SANDBOX=true

# ---- Research agent (Gemini Flash, free tier) ----------------------
# Get a free key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_RESEARCH_MODEL=gemini-2.5-flash

# ---- Risk limits (hard caps — the engine cannot be told to exceed these)
RISK_MAX_SINGLE_ASSET_PCT=0.05     # 5%  max exposure to any one asset
RISK_MAX_DAILY_LOSS_PCT=0.02       # 2%  daily loss -> stop trading
RISK_MAX_DRAWDOWN_PCT=0.15         # 15% peak-to-trough -> kill switch
RISK_MAX_GROSS_EXPOSURE_PCT=0.70   # 70% of equity deployable at once

# ---- Capital -------------------------------------------------------
STARTING_EQUITY_USD=1000           # paper-mode notional starting bankroll
