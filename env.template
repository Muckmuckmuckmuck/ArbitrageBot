# Coinbase + Gemini Arbitrage Bot - Environment Variables
# Copy this file to .env and fill in your actual API keys

# ============================================================================
# COINBASE ADVANCED API KEYS
# ============================================================================
# Get from: https://www.coinbase.com/settings/api
# Permissions needed: View, Trade, Transfer

COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET_KEY=your_coinbase_secret_key_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here
COINBASE_SANDBOX=false

# ============================================================================
# GEMINI API KEYS
# ============================================================================
# Get from: https://www.gemini.com/settings/api
# Permissions needed: Auditor, Trader, Fund Manager

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_SECRET_KEY=your_gemini_secret_key_here
GEMINI_SANDBOX=false

# ============================================================================
# LOGGING
# ============================================================================

LOG_LEVEL=INFO
LOG_FILE=coinbase_gemini_arbitrage.log

# ============================================================================
# IMPORTANT NOTES
# ============================================================================
#
# 1. NEVER commit .env file to Git (it's in .gitignore)
# 2. For Railway deployment, add these as Environment Variables
# 3. Make sure API keys have TRANSFER/FUND MANAGER permissions
# 4. Whitelist addresses on both exchanges before starting
# 5. Start with SANDBOX=true for testing, then switch to false
#
# ============================================================================

